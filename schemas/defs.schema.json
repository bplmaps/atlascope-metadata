{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "Atlascope shared definitions",
  "description": "Definitions shared by the atlas-layer and reference-layer schemas.",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^\\S+$",
      "description": "Unique layer id within an instance, used in app URLs. ARK for atlas layers (e.g. ark:/76611/amll458jy); a short slug for reference layers (e.g. massgis-2023-orthos). The layer's filename is derived from it."
    },
    "year": {
      "description": "Year the layer depicts, which is not necessarily its publication year. Used for chronological ordering and display.",
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}$" },
        { "type": "integer", "minimum": 1000, "maximum": 9999 }
      ]
    },
    "bibliographicEntry": {
      "type": "string",
      "minLength": 1,
      "description": "Citation shown in the layer info panel. Markdown: italics for titles, links for credits."
    },
    "fallbackSubtitle": {
      "type": "string",
      "minLength": 1,
      "description": "Subtitle used when no publisherShort applies, e.g. 'Aerial Imagery'."
    },
    "source": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["tilejson", "xyz"] },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "TileJSON URL, or XYZ template containing {z}, {x} and {y}."
        },
        "hidden": {
          "type": "boolean",
          "description": "Layer is loadable but not offered in the layer pickers (e.g. the fallback street basemap)."
        }
      },
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "xyz" } } },
      "then": {
        "properties": { "url": { "pattern": "\\{z\\}.*\\{[xy]\\}.*\\{[xy]\\}" } }
      }
    },
    "sponsor": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2
    },
    "linearRing": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" },
      "minItems": 4
    },
    "polygonCoordinates": {
      "type": "array",
      "items": { "$ref": "#/$defs/linearRing" },
      "minItems": 1
    },
    "footprint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "$ref": "#/$defs/polygonCoordinates" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": {
              "type": "array",
              "items": { "$ref": "#/$defs/polygonCoordinates" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
